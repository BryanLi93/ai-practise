# LLM —— chat 和 embedding 都走 OpenAI 兼容中转站(同一个 base_url + key)
OPENAI_API_KEY=your-relay-api-key
OPENAI_BASE_URL=https://your-relay-host/v1
# chat 模型名(取决于你的中转站)
CHAT_MODEL=gpt-5.4
# embedding 模型名:text-embedding-3-small(1536 原生)或 text-embedding-3-large(3072,截断到 1536)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Database
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# App
LOG_LEVEL=INFO
