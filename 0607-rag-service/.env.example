# LLM —— chat / embedding / rerank 都走硅基流动(SiliconFlow)OpenAI 兼容接口(同一个 base_url + key)
OPENAI_API_KEY=your-siliconflow-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# chat 模型名(硅基流动)
CHAT_MODEL=Qwen/Qwen3.5-9B
# embedding 模型名:BAAI/bge-m3(固定 1024 维,不支持 dimensions 参数)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# rerank 模型名(走 SiliconFlow /v1/rerank)
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Database
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# App
LOG_LEVEL=INFO
